{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "bracketSpacing": false,
  "quoteProps": "consistent",
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true
  },
  "ignorePatterns": ["dist/**", "packages/*/wasm/**", "pnpm-lock.yaml", "CHANGELOG.md"]
}
