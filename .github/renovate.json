{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>sanity-io/renovate-config"],
  "ignorePresets": ["github>sanity-io/renovate-config:group-non-major"],
  "packageRules": [
    {
      "description": "Pinned: this package uses @sanity/codegen internals, so each release is adopted on its own and only after CI.",
      "matchPackageNames": ["@sanity/codegen"],
      "rangeStrategy": "pin",
      "groupName": null,
      "automerge": false
    },
    {
      "matchPackageNames": ["oxlint", "oxlint-tsgolint"],
      "groupName": "oxlint",
      "semanticCommitType": "chore"
    },
    {
      "description": "The content mapper tests run against TypeScript 7.1, the first release with content mappers",
      "matchPackageNames": ["typescript-7.1"],
      "enabled": false
    }
  ]
}
